# Every variable is optional. With none set, the app runs entirely on built-in demo data.

# Clock: "demo" (steerable, starts now or at ?at=) or "browser" (real time only).
VITE_CLOCK=demo
# Storage for preferences: "browser" (localStorage) or "memory" (forgotten on reload).
VITE_STORAGE=browser
# Haptics: "browser" (Vibration API where supported) or "demo" (recorded, silent).
VITE_HAPTICS=browser
# Sharing: "browser" (share sheet or clipboard) or "demo" (recorded only).
VITE_SHARE=browser
# Clipboard for Copy buttons: "browser" (system clipboard) or "demo" (recorded only).
VITE_CLIPBOARD=browser
# Error reports: "browser" (the console) or "demo" (recorded, silent).
VITE_REPORTER=browser
