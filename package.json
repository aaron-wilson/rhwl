{
  "name": "rhwl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/check-bundle.ts",
    "start": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude \"**/*.perf.test.ts\"",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.ts",
    "lint": "eslint . --max-warnings 0 && node scripts/check-realism.ts && node scripts/check-e2e.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.ts",
    "typecheck": "tsc -p .",
    "tokens": "node scripts/generate-tokens.ts",
    "icons": "node scripts/render-icons.ts",
    "check:commits": "node scripts/check-commits.ts",
    "check:size": "node scripts/commit-size.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
